{
  "name": "ernestdefoe/fbsfb-theme",
  "description": "FBSFB — college-football Gridiron Crimson theme for Flarum 2, built on ernestdefoe/bespoke: crimson brand, dark→crimson hero header, and normalized tag icons (uniform sizing for the custom fa-kit team logos). Pairs with Bespoke's gridiron preset.",
  "keywords": [
    "flarum",
    "flarum-extension",
    "theme",
    "crimson",
    "football",
    "gridiron",
    "college-football"
  ],
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "ernestdefoe",
      "email": "ernestdefoe@gmail.com"
    }
  ],
  "homepage": "https://github.com/ernestdefoe/fbsfb-theme",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/ernestdefoe/bespoke"
    }
  ],
  "require": {
    "flarum/core": "^2.0",
    "ernestdefoe/bespoke": "^2.0"
  },
  "autoload-dev": {
    "psr-4": {
      "ErnestDefoe\\FbsfbTheme\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "flarum/phpstan": "^2.0",
    "flarum/testing": "^2.0",
    "laravel/pint": "^1.32"
  },
  "extra": {
    "flarum-extension": {
      "title": "FBSFB — Gridiron Crimson Theme",
      "category": "theme",
      "icon": {
        "name": "fa-solid fa-football",
        "backgroundColor": "#9e1b32",
        "color": "#ffffff"
      }
    },
    "flarum-cli": {
      "modules": {
        "css": true,
        "locale": true
      }
    }
  },
  "scripts": {
    "test": [
      "@test:integration"
    ],
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php",
    "analyse:phpstan": "phpstan analyse",
    "style": "pint --test",
    "style:fix": "pint"
  },
  "scripts-descriptions": {
    "test": "Runs all tests.",
    "test:integration": "Runs all integration tests.",
    "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
    "analyse:phpstan": "Run static analysis",
    "style": "Checks the code style",
    "style:fix": "Fixes the code style"
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
